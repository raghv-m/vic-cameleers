# Copy this file to .env (local dev) and fill in real values.
# Never commit .env or any file containing real secrets.

# Postgres via Neon (Vercel Marketplace, ap-southeast-2 / Sydney region).
# DATABASE_URL is the pooled connection the app uses at runtime.
# DIRECT_URL is Neon's unpooled connection, used only for migrations.
DATABASE_URL="postgresql://user:password@host/vic_cameleers?sslmode=require"
DIRECT_URL="postgresql://user:password@host/vic_cameleers?sslmode=require"

# Public site origin, https, no trailing slash. The single source for every absolute URL:
# canonicals, sitemap, robots, JSON-LD, OG tags, llms.txt, auth. Vercel production and preview
# builds fail if this is empty or localhost (src/config/site-url.ts). Until a custom domain
# exists, set it to https://vic-cameleers.vercel.app in Vercel.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="Vic Cameleers <quotes@example.com>"
EMAIL_REPLY_TO=""

# Internal-only. Must never appear in public site output, structured data, or customer emails.
LEAD_NOTIFY_EMAIL=""

# Cloudflare Turnstile (bot protection on all public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Vercel Blob (quote photo uploads)
BLOB_READ_WRITE_TOKEN=""

# Google Maps Platform. The public key is restricted by HTTP referrer for
# Places Autocomplete in the browser; the server key is restricted by API
# (Distance Matrix / Routes) and never sent to the client.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# Auth session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Secret path prefix for the admin console: "ops-" plus 32+ random hex characters, e.g.
# node -e "console.log('ops-'+require('crypto').randomBytes(24).toString('hex'))"
# Never "admin", never reused between environments, never committed. Obscurity only: the real
# gate is auth + 2FA, and signed-out visitors get a 404 on every protected admin page.
ADMIN_PATH=""

# Shared secret required on every /api/cron/* request (Vercel Cron Jobs).
CRON_SECRET=""

# Link used in review-request emails and the reviews page.
GOOGLE_REVIEW_URL=""

# Phase 2
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Error tracking (server side). Leave empty to turn Sentry off.
SENTRY_DSN=""
